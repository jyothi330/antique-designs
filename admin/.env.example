# ─────────────────────────────────────────────────────────────────────────────
# Antique Designs Admin — Firebase Environment Variables
#
# Copy this file to .env.local and fill in values from your Firebase Console:
#   https://console.firebase.google.com → Project Settings → General → Your apps
#
# NEVER commit .env.local to version control.
# All VITE_ variables are embedded in the client bundle — do NOT put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
